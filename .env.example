DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Para Turso, reemplazá DATABASE_URL por la URL libsql:// de la base
# y configurá DATABASE_AUTH_TOKEN con su token privado.

# El seed local genera el secreto y las contraseñas faltantes en .env.local.
# Para el seed remoto completá SESSION_SECRET y las cuatro variables SEED_*.
# SESSION_SECRET=
# SEED_ADMIN_EMAIL=admin@gestion.test
# SEED_ADMIN_PASSWORD=
# SEED_VENDEDOR_EMAIL=vendedor@gestion.test
# SEED_VENDEDOR_PASSWORD=

# Botones de modo demo del login: entran por el login normal con estas cuentas.
# Sin valor, el botón de ese rol no aparece. En el sitio publicado, cualquiera puede usarlos.
# DEMO_ADMIN_EMAIL=admin@gestion.test
# DEMO_ADMIN_PASSWORD=
# DEMO_VENDEDOR_EMAIL=vendedor@gestion.test
# DEMO_VENDEDOR_PASSWORD=
